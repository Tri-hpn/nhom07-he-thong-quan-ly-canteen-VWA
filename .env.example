# ============================================================
# .env.example — Template cho team
# ============================================================
# Cách dùng:
#   1. cp .env.example .env
#   2. Điền giá trị thật vào .env
#   3. KHÔNG commit .env
# ============================================================

# ---------- Frontend (Vite) ----------
# Local dev: để trống → Vite proxy /api → localhost:3000
# Production (Vercel): để trống → API chạy cùng domain qua /api
# (Nếu backend chạy domain riêng, điền URL đầy đủ vào đây)
VITE_API_URL=

# ---------- Backend (Express) ----------
NODE_ENV=production
PORT=3000

# ---------- Security ----------
# JWT secret — BẮT BUỘC đổi trước khi deploy production
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_to_a_strong_random_string

# ---------- MongoDB ----------
# Atlas: mongodb://user:pass@cluster.mongodb.net/dbname?retryWrites=true&w=majority
# Local: mongodb://localhost:27017/canteen
MONGO_URI=

# ============================================================
# OAUTH — Đăng nhập Google + Facebook
# ============================================================
# Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Facebook Developers:  https://developers.facebook.com/apps
#
# Redirect URI cần đăng ký:
#   Dev:  http://localhost:5173/auth/google/callback
#         http://localhost:5173/auth/facebook/callback
#   Prod: https://canteen-goo.vercel.app/auth/google/callback
#         https://canteen-goo.vercel.app/auth/facebook/callback
#
# ⚠️ CHÚ Ý:
#   - VITE_* sẽ bị nhúng vào JS bundle (FE) → ai cũng xem được.
#   - Client ID / App ID là PUBLIC → OK để VITE_.
#   - Client Secret / App Secret PHẢI để BE (không VITE_).
# ============================================================

# ---------- Google OAuth ----------
# FE dùng (Vite expose ra client):
VITE_GOOGLE_CLIENT_ID=

# BE dùng (chỉ server đọc):
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Facebook OAuth ----------
# FE dùng (Vite expose ra client):
VITE_FACEBOOK_APP_ID=

# BE dùng (chỉ server đọc):
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ---------- Holiday API (Gravitee Gateway) ----------
# ⚠️ Các biến này nhúng vào bundle FE — chỉ dùng cho internal/demo
# Nếu là production, nên proxy qua backend
VITE_HOLIDAY_API_URL=
VITE_GRAVITEE_API_KEY=
VITE_GRAVITEE_SECRET_KEY=

# ---------- Optional ----------
# CORS_ORIGIN=http://localhost:5173
# MAX_UPLOAD_SIZE=5242880
# DB_PATH=./canteen-db.json
# RATE_LIMIT_MAX=100