# ============================================================
# .env.example — Template cho team
# ============================================================
# Cách dùng:
#   1. cp .env.example .env
#   2. Điền giá trị thật vào .env
#   3. KHÔNG commit .env
# ============================================================

# ---------- App ----------
# Local dev: PHẢI để development
# Production (Vercel): Vercel tự set NODE_ENV=production, KHÔNG cần khai báo lại
# ⚠️ Đừng để production ở đây — sẽ làm dev local mất stack trace, sai behavior
NODE_ENV=development
PORT=3000

# ---------- Frontend (Vite) ----------
# Local dev: để trống → Vite proxy /api → localhost:3000
# Production (Vercel): để trống → API chạy cùng domain qua /api
# (Nếu backend chạy domain riêng, điền URL đầy đủ vào đây)
VITE_API_URL=

# Dev-only: URL backend khi chạy `npm run dev` (Vite proxy target)
VITE_BACKEND_URL=http://localhost:3000

# Dev-only: giữ nguyên Host header khi proxy (thường để trống)
VITE_KEEP_ORIGIN_HOST=0

# ---------- Security: JWT ----------
# Generate secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_to_a_strong_random_string
JWT_EXPIRES_IN=15m

# Refresh token — dùng cho HttpOnly cookie, fix lỗi F5 logout
JWT_REFRESH_SECRET=change_me_to_another_strong_random_string
JWT_REFRESH_EXPIRES_IN=7d

# Số vòng bcrypt (10 = ~100ms/hash, 12 = ~400ms). Prod nên 10–12.
BCRYPT_ROUNDS=10

# ---------- CORS ----------
# Comma-separated các origin được phép gửi credentials
CORS_ORIGIN=http://localhost:5173

# ---------- MongoDB ----------
# Atlas: mongodb://user:pass@cluster.mongodb.net/dbname?retryWrites=true&w=majority
# Local: mongodb://localhost:27017/canteen
MONGO_URI=

# ============================================================
# OAUTH — Đăng nhập Google + Facebook
# ============================================================
# Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Facebook Developers:  https://developers.facebook.com/apps
#
# Redirect URI cần đăng ký:
#   Dev:  http://localhost:5173/auth/google/callback
#         http://localhost:5173/auth/facebook/callback
#   Prod: https://canteen-goo.vercel.app/auth/google/callback
#         https://canteen-goo.vercel.app/auth/facebook/callback
#
# ⚠️ CHÚ Ý:
#   - VITE_* sẽ bị nhúng vào JS bundle (FE) → ai cũng xem được.
#   - Client ID / App ID là PUBLIC → OK để VITE_.
#   - Client Secret / App Secret PHẢI để BE (không VITE_).
# ============================================================

# ---------- Google OAuth ----------
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Facebook OAuth ----------
VITE_FACEBOOK_APP_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ---------- Holiday API (Gravitee Gateway) ----------
# ⚠️ Các biến này nhúng vào bundle FE — chỉ dùng cho internal/demo
# Nếu là production, nên proxy qua backend
VITE_HOLIDAY_API_URL=
VITE_GRAVITEE_API_KEY=
VITE_GRAVITEE_SECRET_KEY=

# ---------- Rate limit / Upload ----------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
MAX_UPLOAD_SIZE=5242880

# ---------- Optional ----------
# DB_PATH=./canteen-db.json
# LOG_LEVEL=info