curl --location --request GET '{{baseUrl}}/api/reviews/me' \
--header 'accept: application/json' \
--header 'Authorization: Bearer {{token}}'


# ============================================================
# 1️⃣2️⃣  POINTS — Điểm tích lũy
# ============================================================

### 12.1. Xem điểm + lịch sử
curl --location --request GET '{{baseUrl}}/api/points/me' \
--header 'accept: application/json' \
--header 'Authorization: Bearer {{token}}'

### 12.2. Đổi điểm thành voucher
curl --location --request POST '{{baseUrl}}/api/points/redeem' \
--header 'accept: application/json' \
--header 'content-type: application/json' \
--header 'Authorization: Bearer {{token}}' \
--data-raw '{
  "points": 100
}'


