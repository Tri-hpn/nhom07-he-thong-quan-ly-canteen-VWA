# ============================================================
# CANTEEN VWA — API TEST COLLECTION
# ============================================================
# Base URL: https://canteen-goo.onrender.com
#
# CÁCH DÙNG:
#   1. Chạy request [AUTH] Login đầu tiên → copy token
#   2. Paste token vào biến {{token}} bên dưới
#   3. Chạy các request khác theo thứ tự
#
# TÀI KHOẢN DEMO:
#   Admin    : admin@vwa.vn    / 123456
#   Employee : nhanvien@vwa.vn / 123456
#   Customer : sinhvien@vwa.vn / 123456
#
# LƯU Ý:
#   - Render free tier cold start ~30s lần request đầu
#   - Token hết hạn sau 7 ngày
#   - KHÔNG chạy [BACKUP] Reset bừa — sẽ xoá hết dữ liệu
#
# ✅ UPDATE (theo fix mới):
#   - GET /api/menu         → trả về TẤT CẢ món (kể cả active=0)
#   - GET /api/menu?active_only=1 → chỉ trả món đang bán (Customer dùng)
#   - Bỏ query param ?all=1 (không còn cần thiết)
# ============================================================

@baseUrl = https://canteen-goo.onrender.com
@token = PASTE_TOKEN_HERE


# ============================================================
# 1️⃣  AUTH — Đăng nhập & tài khoản
# ============================================================

### 1.1. Login (chạy ĐẦU TIÊN để lấy token)
# @name login
curl --location --request POST '{{baseUrl}}/api/auth/login' \
--header 'accept: application/json' \
--header 'content-type: application/json' \
--data-raw '{
  "email": "admin@vwa.vn",
  "password": "123456"
}'

### 1.2. Register khách hàng mới
curl --location --request POST '{{baseUrl}}/api/auth/register' \
--header 'accept: application/json' \
--header 'content-type: application/json' \
--data-raw '{
  "email": "test@vwa.vn",
  "password": "123456",
  "name": "Test User",
  "phone": "0901234567"
}'

### 1.3. Lấy info cá nhân
curl --location --request GET '{{baseUrl}}/api/auth/me' \
--header 'accept: application/json' \
--header 'Authorization: Bearer {{token}}'

### 1.4. Cập nhật profile
curl --location --request PUT '{{baseUrl}}/api/auth/profile' \
--header 'accept: application/json' \
--header 'content-type: application/json' \
--header 'Authorization: Bearer {{token}}' \
--data-raw '{
  "name": "Nguyễn Văn A",
  "phone": "0901234567",
  "address": "Hà Nội"
}'

### 1.5. Đổi mật khẩu
curl --location --request PUT '{{baseUrl}}/api/auth/password' \
--header 'accept: application/json' \
--header 'content-type: application/json' \
--header 'Authorization: Bearer {{token}}' \
--data-raw '{
  "currentPassword": "123456",
  "newPassword": "newpass123"
}'


# ============================================================
# 2️⃣  MENU — Thực đơn
# ============================================================

### 2.1. Lấy TẤT CẢ món (kể cả active=0) — dùng cho Admin/Employee
# ✅ ĐÃ UPDATE: bỏ ?all=1, endpoint mặc định trả hết
curl --location --request GET '{{baseUrl}}/api/menu' \
--header 'accept: application/json'

### 2.1b. Chỉ lấy món ĐANG BÁN (active=1) — dùng cho Customer
# ✅ MỚI: dùng ?active_only=1
curl --location --request GET '{{baseUrl}}/api/menu?active_only=1' \
--header 'accept: application/json'

### 2.2. Tìm kiếm + lọc theo category
curl --location --request GET '{{baseUrl}}/api/menu?q=cơm&category=Cơm&sort=popular' \
--header 'accept: application/json'

### 2.2b. Tìm kiếm + lọc cho Customer (chỉ món đang bán)
curl --location --request GET '{{baseUrl}}/api/menu?q=cơm&active_only=1' \
--header 'accept: application/json'

### 2.3. Lấy chi tiết 1 món
curl --location --request GET '{{baseUrl}}/api/menu/1' \
--header 'accept: application/json'

### 2.4. Tạo món mới (ADMIN)
curl --location --request POST '{{baseUrl}}/api/menu' \
--header 'accept: application/json' \
--header 'content-type: application/json' \
--header 'Authorization: Bearer {{token}}' \
--data-raw '{
  "name": "Cơm gà test",
  "category": "Cơm",
  "price": 35000,
  "stock": 50,
  "description": "Món test",
  "image": "https://example.com/image.jpg"
}'

### 2.5. Cập nhật món (ADMIN)
curl --location --request PUT '{{baseUrl}}/api/menu/1' \
--header 'accept: application/json' \
--header 'content-type: application/json' \
--header 'Authorization: Bearer {{token}}' \
--data-raw '{
  "price": 30000,
  "stock": 100,
  "reason": "Giảm giá test"
}'

### 2.6. Tắt món (ADMIN) — set active = 0
# ✅ SAU KHI FIX: món tắt vẫn xuất hiện ở:
#   - GET /api/menu (không param) → Admin/Employee thấy
#   - KHÔNG xuất hiện ở GET /api/menu?active_only=1 → Customer không thấy
curl --location --request PUT '{{baseUrl}}/api/menu/1' \
--header 'accept: application/json' \
--header 'content-type: application/json' \
--header 'Authorization: Bearer {{token}}' \
--data-raw '{
  "active": 0
}'

### 2.7. Bật món (ADMIN) — set active = 1
curl --location --request PUT '{{baseUrl}}/api/menu/1' \
--header 'accept: application/json' \
--header 'content-type: application/json' \
--header 'Authorization: Bearer {{token}}' \
--data-raw '{
  "active": 1
}'

### 2.8. Xoá món (ADMIN)
curl --location --request DELETE '{{baseUrl}}/api/menu/1' \
--header 'accept: application/json' \
--header 'Authorization: Bearer {{token}}'


# ============================================================
# 3️⃣  CATEGORIES — Danh mục
# ============================================================

### 3.1. Lấy danh sách danh mục
curl --location --request GET '{{baseUrl}}/api/categories' \
--header 'accept: application/json'

### 3.2. Tạo danh mục mới (ADMIN)
curl --location --request POST '{{baseUrl}}/api/categories' \
--header 'accept: application/json' \
--header 'content-type: application/json' \
--header 'Authorization: Bearer {{token}}' \
--data-raw '{
  "name": "Món nướng",
  "icon": "🔥",
  "order": 8
}'

### 3.3. Cập nhật danh mục (ADMIN)
curl --location --request PUT '{{baseUrl}}/api/categories/1' \
--header 'accept: application/json' \
--header 'content-type: application/json' \
--header 'Authorization: Bearer {{token}}' \
--data-raw '{
  "name": "Cơm",
  "icon": "🍚",
  "order": 1
}'

### 3.4. Xoá danh mục (ADMIN)
curl --location --request DELETE '{{baseUrl}}/api/categories/8' \
--header 'accept: application/json' \
--header 'Authorization: Bearer {{token}}'


# ============================================================
# 4️⃣  USERS — Quản lý người dùng (ADMIN)
# ============================================================

### 4.1. Lấy tất cả users
curl --location --request GET '{{baseUrl}}/api/users' \
--header 'accept: application/json' \
--header 'Authorization: Bearer {{token}}'

### 4.2. Lọc theo role (EMPLOYEE / CUSTOMER / ADMIN)
curl --location --request GET '{{baseUrl}}/api/users?role=EMPLOYEE' \
--header 'accept: application/json' \
--header 'Authorization: Bearer {{token}}'

### 4.3. Tạo user mới (nhân viên)
curl --location --request POST '{{baseUrl}}/api/users' \
--header 'accept: application/json' \
--header 'content-type: application/json' \
--header 'Authorization: Bearer {{token}}' \
--data-raw '{
  "name": "Nguyễn Văn B",
  "email": "employee2@vwa.vn",
  "phone": "0901234567",
  "role": "EMPLOYEE",
  "password": "123456"
}'

### 4.4. Cập nhật user
curl --location --request PUT '{{baseUrl}}/api/users/2' \
--header 'accept: application/json' \
--header 'content-type: application/json' \
--header 'Authorization: Bearer {{token}}' \
--data-raw '{
  "name": "Trần Văn Trí",
  "phone": "0901234567",
  "status": "Hoạt động"
}'

### 4.5. Reset mật khẩu user về 123456
curl --location --request PUT '{{baseUrl}}/api/users/2' \
--header 'accept: application/json' \
--header 'content-type: application/json' \
--header 'Authorization: Bearer {{token}}' \
--data-raw '{
  "password": "123456"
}'

### 4.6. Xoá user
curl --location --request DELETE '{{baseUrl}}/api/users/99' \
--header 'accept: application/json' \
--header 'Authorization: Bearer {{token}}'


# ============================================================
# 5️⃣  ORDERS — Đơn hàng
# ============================================================

### 5.1. Tạo đơn hàng (CUSTOMER)
curl --location --request POST '{{baseUrl}}/api/orders' \
--header 'accept: application/json' \
--header 'content-type: application/json' \
--header 'Authorization: Bearer {{token}}' \
--data-raw '{
  "items": [
    { "menuItem": 1, "qty": 2 },
    { "menuItem": 3, "qty": 1 }
  ],
  "payment": "Tiền mặt",
  "note": "Ít cay",
  "discount": 0,
  "voucherCode": ""
}'

### 5.2. Đơn hàng của tôi (CUSTOMER)
curl --location --request GET '{{baseUrl}}/api/orders/me' \
--header 'accept: application/json' \
--header 'Authorization: Bearer {{token}}'

### 5.3. Tất cả đơn (ADMIN/EMPLOYEE)
curl --location --request GET '{{baseUrl}}/api/orders' \
--header 'accept: application/json' \
--header 'Authorization: Bearer {{token}}'

### 5.4. Lọc theo trạng thái
# Status: Chờ xác nhận | Đã xác nhận | Đang chuẩn bị | Sẵn sàng nhận | Hoàn thành | Đã hủy
curl --location --request GET '{{baseUrl}}/api/orders?status=Chờ xác nhận' \
--header 'accept: application/json' \
--header 'Authorization: Bearer {{token}}'

### 5.5. Chuyển trạng thái đơn (ADMIN/EMPLOYEE)
curl --location --request PATCH '{{baseUrl}}/api/orders/1' \
--header 'accept: application/json' \
--header 'content-type: application/json' \
--header 'Authorization: Bearer {{token}}' \
--data-raw '{
  "status": "Đã xác nhận"
}'

### 5.6. Customer xác nhận đã nhận món
curl --location --request POST '{{baseUrl}}/api/orders/1/received' \
--header 'accept: application/json' \
--header 'Authorization: Bearer {{token}}'

### 5.7. Customer hủy đơn
curl --location --request POST '{{baseUrl}}/api/orders/1/cancel' \
--header 'accept: application/json' \
--header 'Authorization: Bearer {{token}}'


# ============================================================
# 6️⃣  INVENTORY — Kho hàng (ADMIN)
# ============================================================

### 6.1. Danh sách kho
curl --location --request GET '{{baseUrl}}/api/inventory' \
--header 'accept: application/json' \
--header 'Authorization: Bearer {{token}}'

### 6.2. Tạo nguyên liệu
curl --location --request POST '{{baseUrl}}/api/inventory' \
--header 'accept: application/json' \
--header 'content-type: application/json' \
--header 'Authorization: Bearer {{token}}' \
--data-raw '{
  "code": "NL999",
  "name": "Nguyên liệu test",
  "qty": 100,
  "unit": "kg",
  "min": 20
}'

### 6.3. Cập nhật nguyên liệu
curl --location --request PUT '{{baseUrl}}/api/inventory/NL999' \
--header 'accept: application/json' \
--header 'content-type: application/json' \
--header 'Authorization: Bearer {{token}}' \
--data-raw '{
  "qty": 150,
  "min": 30
}'

### 6.4. Nhập kho
curl --location --request POST '{{baseUrl}}/api/inventory/NL999/import' \
--header 'accept: application/json' \
--header 'content-type: application/json' \
--header 'Authorization: Bearer {{token}}' \
--data-raw '{
  "qty": 50,
  "supplier": "NCC Test",
  "note": "Nhập kho test"
}'

### 6.5. Lịch sử nhập kho
curl --location --request GET '{{baseUrl}}/api/inventory/imports' \
--header 'accept: application/json' \
--header 'Authorization: Bearer {{token}}'

### 6.6. Xoá nguyên liệu
curl --location --request DELETE '{{baseUrl}}/api/inventory/NL999' \
--header 'accept: application/json' \
--header 'Authorization: Bearer {{token}}'


# ============================================================
