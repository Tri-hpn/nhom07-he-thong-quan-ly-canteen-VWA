--header 'accept: application/json' \
--header 'Authorization: Bearer {{token}}'


# ============================================================
# 8️⃣  SHIFTS — Ca làm việc
# ============================================================

### 8.1. Ca của tôi
curl --location --request GET '{{baseUrl}}/api/shifts/me' \
--header 'accept: application/json' \
--header 'Authorization: Bearer {{token}}'

### 8.2. Đăng ký ca (EMPLOYEE)
curl --location --request POST '{{baseUrl}}/api/shifts/register' \
--header 'accept: application/json' \
--header 'content-type: application/json' \
--header 'Authorization: Bearer {{token}}' \
--data-raw '{
