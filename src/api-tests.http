curl --location --request GET '{{baseUrl}}/api/backup/export' \
--header 'accept: application/json' \
--header 'Authorization: Bearer {{token}}'

### 18.2. Thống kê database
curl --location --request GET '{{baseUrl}}/api/backup/stats' \
--header 'accept: application/json' \
--header 'Authorization: Bearer {{token}}'

### 18.3. Import (cần body lớn — không test qua Postman)
curl --location --request POST '{{baseUrl}}/api/backup/import' \
--header 'accept: application/json' \
--header 'content-type: application/json' \
--header 'Authorization: Bearer {{token}}' \
--data-raw '{
  "data": { "users": [], "menu_items": [] }
}'

### 18.4. Reset database (⚠️ NGUY HIỂM — chỉ dùng khi cần)
curl --location --request POST '{{baseUrl}}/api/backup/reset' \
--header 'accept: application/json' \
--header 'content-type: application/json' \
--header 'Authorization: Bearer {{token}}' \
--data-raw '{
  "confirm": "RESET"
}'


