}'


# ============================================================
# 🔟  VOUCHERS — Mã giảm giá
# ============================================================

### 10.1. Ví voucher của tôi
curl --location --request GET '{{baseUrl}}/api/vouchers/me' \
--header 'accept: application/json' \
--header 'Authorization: Bearer {{token}}'

### 10.2. Voucher public (nhận được)
curl --location --request GET '{{baseUrl}}/api/vouchers/public' \
--header 'accept: application/json' \
--header 'Authorization: Bearer {{token}}'

### 10.3. Kiểm tra mã voucher có hợp lệ
curl --location --request POST '{{baseUrl}}/api/vouchers/validate' \
--header 'accept: application/json' \
--header 'content-type: application/json' \
--header 'Authorization: Bearer {{token}}' \
--data-raw '{
  "code": "VOUCHER0001"
}'

### 10.4. Nhận voucher public
curl --location --request POST '{{baseUrl}}/api/vouchers/claim/14' \
--header 'accept: application/json' \
--header 'Authorization: Bearer {{token}}'

### 10.5. Danh sách tất cả voucher (ADMIN)
curl --location --request GET '{{baseUrl}}/api/vouchers' \
--header 'accept: application/json' \
--header 'Authorization: Bearer {{token}}'

### 10.6. Tạo voucher (ADMIN)
# user_id: null = voucher public (mọi người nhận được)
curl --location --request POST '{{baseUrl}}/api/vouchers' \
--header 'accept: application/json' \
--header 'content-type: application/json' \
--header 'Authorization: Bearer {{token}}' \
--data-raw '{
  "code": "SALE2026",
  "value": 30000,
  "user_id": null,
  "points_used": 0
}'

### 10.7. Cập nhật voucher (ADMIN)
curl --location --request PUT '{{baseUrl}}/api/vouchers/14' \
--header 'accept: application/json' \
--header 'content-type: application/json' \
--header 'Authorization: Bearer {{token}}' \
--data-raw '{
  "value": 50000,
  "used": false
}'

### 10.8. Xoá voucher (ADMIN)
curl --location --request DELETE '{{baseUrl}}/api/vouchers/14' \
--header 'accept: application/json' \
--header 'Authorization: Bearer {{token}}'

### 10.9. Thống kê voucher (ADMIN)
curl --location --request GET '{{baseUrl}}/api/vouchers/stats' \
--header 'accept: application/json' \
--header 'Authorization: Bearer {{token}}'

### 10.10. Danh sách người đã claim (ADMIN)
curl --location --request GET '{{baseUrl}}/api/vouchers/claims/14' \
--header 'accept: application/json' \
--header 'Authorization: Bearer {{token}}'

### 10.11. Ví voucher của 1 user (ADMIN)
curl --location --request GET '{{baseUrl}}/api/vouchers/user/3' \
--header 'accept: application/json' \
--header 'Authorization: Bearer {{token}}'

### 10.12. Thu hồi voucher (ADMIN)
curl --location --request DELETE '{{baseUrl}}/api/vouchers/revoke/20' \
--header 'accept: application/json' \
--header 'Authorization: Bearer {{token}}'


# ============================================================
# 1️⃣1️⃣  REVIEWS — Đánh giá món
