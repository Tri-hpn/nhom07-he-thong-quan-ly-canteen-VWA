curl --location --request POST '{{baseUrl}}/api/attendance/checkout' \
--header 'accept: application/json' \
--header 'content-type: application/json' \
--header 'Authorization: Bearer {{token}}' \
--data-raw '{
  "shift": "Ca sáng"
}'

### 7.3. Chấm công hôm nay
curl --location --request GET '{{baseUrl}}/api/attendance/today' \
--header 'accept: application/json' \
--header 'Authorization: Bearer {{token}}'

### 7.4. Lịch sử chấm công của tôi
curl --location --request GET '{{baseUrl}}/api/attendance/me' \
--header 'accept: application/json' \
--header 'Authorization: Bearer {{token}}'

